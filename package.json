{
  "name": "aether",
  "version": "1.0.0",
  "description": "Aether — An aesthetic Windows terminal with themes, tabs, and crisp inline graphics",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/verify.js",
    "build:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.8.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.aether.terminal",
    "productName": "Aether",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "src/shell/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/aether.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aether",
      "include": "build/installer.nsh",
      "installerIcon": "assets/aether.ico",
      "uninstallerIcon": "assets/aether.ico",
      "installerHeaderIcon": "assets/aether.ico"
    }
  }
}
